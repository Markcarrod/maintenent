# -------------------------------------------------------------
# SUPABASE & PRISMA CONFIGURATION
# -------------------------------------------------------------

# Supabase PostgreSQL connection URL (Session or Transaction pooler on port 6543 / 5432)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (Port 5432) for Prisma migrations
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (For Auth, Realtime, and Media Storage)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
